# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube a git (está en .gitignore).

# Base de datos.
#  - PostgreSQL (Neon):
#    DATABASE_URL=postgresql://usuario:contraseña@host.neon.tech/nombre_db?sslmode=require
#  - SQLite local (desarrollo):
#    DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db

# Clave para firmar los tokens JWT: mínimo 32 caracteres, distinta en cada entorno.
# La app NO arranca con el valor de ejemplo. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-secreta-larga

# CORS: orígenes del frontend separados por coma (además de las URLs del proyecto en Vercel).
# CORS_ORIGINS=http://localhost:4200

# Proxies propios delante de la app (en Render hay 1). Sirve para conocer la IP
# real del cliente en los límites de frecuencia. En local, sin proxy, usa 0.
# PROXIES_CONFIABLES=1

# Cloudinary: almacenamiento de adjuntos (fotos, video, audio, documentos).
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Si se deja vacío, la subida de adjuntos queda deshabilitada.
CLOUDINARY_URL=

# SMTP para el envío masivo (opcional; sin él, el envío queda en modo "simulado").
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
